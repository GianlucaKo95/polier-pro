# Supabase-Zugangsdaten — Datei kopieren zu ".env" und mit echten Werten
# aus Supabase Dashboard → Settings → API befüllen.
# .env selbst wird NIE committed (steht in .gitignore).
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-KEY

# Optional: öffentlicher VAPID-Key für echte Server-Push-Benachrichtigungen
# (siehe supabase-push-notifications.sql). Ohne diesen Wert bleibt die App
# voll funktionsfähig — es gibt dann nur lokale Erinnerungen statt echtem
# Push. NIEMALS den privaten VAPID-Key hier eintragen, der gehört
# ausschließlich als Supabase Edge Function Secret gesetzt (siehe
# polier_pro/supabase/functions/send-push-reminders/index.ts).
VITE_PUSH_VAPID_PUBLIC=
